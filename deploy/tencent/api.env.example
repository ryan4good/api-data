SERVICE_NAME=bizdevops-api
APP_ENV=trial
HTTP_ADDRESS=127.0.0.1:18080
MYSQL_DSN=bizdevops:replace-me@tcp(127.0.0.1:3306)/bizdevops?parseTime=true&charset=utf8mb4&loc=UTC
AUTH_MODE=jwt
AUTH_JWT_ISSUER=replace-me
AUTH_JWT_AUDIENCE=replace-me
AUTH_JWT_SIGNING_KEY=replace-me
AUTH_JWT_TOKEN_TTL=15m
AUTH_COOKIE_NAME=bizdevops_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_PATH=/bizdevops/
CONNECTOR_HTTP_ALLOWED_HOSTS=
CONNECTOR_HTTP_ALLOW_PRIVATE=false
HTTP_EXECUTOR_ALLOWED_HOSTS=
HTTP_EXECUTOR_ALLOW_PRIVATE=false
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
